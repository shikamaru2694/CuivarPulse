  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "^4.16.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rollup": "^4.68.7",
    "typescript": "5.9.3"
  }
}
